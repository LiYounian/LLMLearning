# 参考模板：拷到 /etc/systemd/system/llmlearning-update.service（按需改路径/用户）
# 职责：跑一次 update.sh，让服务器仓库副本跟随 origin/main。
[Unit]
Description=LLMLearning auto-update (git follow origin/main)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
# 关键：git 走 SSH deploy key 时必须有 HOME，否则找不到 ~/.ssh
Environment=HOME=/home/deploy
# clone 路径按实际替换（本手册用 /srv/llmlearning）
ExecStart=/srv/llmlearning/deploy/update.sh
